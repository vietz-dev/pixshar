generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified Boolean   @default(false)
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  events        Event[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("verification")
}

model Event {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  description         String?
  passwordHash        String
  password            String?
  status              String   @default("PROCESSING")
  processedPhotoCount Int      @default(0)
  createdById         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdBy           User     @relation(fields: [createdById], references: [id])
  photos              Photo[]
  // Up to two independent archive builds per event — one per ArchiveQuality
  // variant (DISPLAY / ORIGINAL). Was a single DownloadJob? before the
  // quality dimension was added.
  downloadJobs        DownloadJob[]

  @@map("event")
}

model Photo {
  id               String    @id @default(cuid())
  eventId          String
  photographerName String?
  originalKey      String
  displayKey       String
  thumbKey         String
  // PENDING | PROCESSING | PROCESSED | FAILED. The row is also the durable
  // PENDING | PROCESSING | PROCESSED | FAILED.
  // attempts and lastError retained for admin UI visibility; pg-boss manages retry scheduling.
  status             String    @default("PENDING")
  uploadedBy         String    @default("ADMIN")
  fileHash           String?
  sizeBytes          Int?
  placeholderDataUrl String?
  attempts           Int       @default(0)
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  event            Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, fileHash])
  @@map("photo")
}

enum DownloadJobStatus {
  DEBOUNCING
  QUEUED
  BUILDING
  READY
  FAILED
  CANCELLED
  // The archive is a cache, not an artifact: EXPIRED means the ZIP objects were
  // reclaimed from S3 while the job + its parts (the membership) stay intact, so
  // a later request rebuilds the same parts with the same partIndex.
  EXPIRED
}

// Which source objects a download archive zips.
//   DISPLAY  (Kompakt) — the 1920px / q85 display JPEGs (photo.displayKey)
//   ORIGINAL          — the full-resolution uploads (photo.originalKey)
// Default ORIGINAL: pre-existing jobs zipped originals, so migrating them to
// ORIGINAL is a no-op data-wise.
enum ArchiveQuality {
  DISPLAY
  ORIGINAL
}

model DownloadJob {
  id              String            @id @default(cuid())
  eventId         String
  // The archive variant this job builds. The job (not the part) carries the
  // variant because the job is the unit a worker atomically claims — two
  // variants ⇒ two independently claimable jobs per event.
  quality         ArchiveQuality    @default(ORIGINAL)
  status          DownloadJobStatus @default(DEBOUNCING)
  photoCount      Int               @default(0)
  processedPhotos Int               @default(0)
  uploadProgress  Int               @default(0)
  // Aggregates over parts; BigInt because a gallery archive can exceed 2^31 bytes.
  totalSizeBytes    BigInt?
  partCount         Int               @default(0)
  // FIFO ordering for the per-worker serial build queue.
  queuedAt          DateTime?
  debounceUntil     DateTime?
  debounceStartedAt DateTime?
  heartbeatAt       DateTime?
  failureReason     String?
  // Idle clock for expiry: idleSince = COALESCE(lastDownloadedAt, readyAt).
  // readyAt is stamped on every → READY transition so an archive nobody ever
  // downloads still has a starting point for the clock.
  lastDownloadedAt  DateTime?
  readyAt           DateTime?
  expiredAt         DateTime?
  // Counters live in the DB (not in-process) so they survive restarts/rollouts.
  expiryCount       Int               @default(0)
  rebuildCount      Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  event Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  parts DownloadArchivePart[]

  @@unique([eventId, quality])
  @@map("download_job")
}

model DownloadArchivePart {
  id        String   @id @default(cuid())
  jobId     String
  partIndex Int // 1-based, stable identity — never renumbered, gaps allowed
  key       String
  sizeBytes BigInt   @default(0)
  // READY | BUILDING | STALE | EXPIRED. A part is immutable once READY; it is
  // only ever rebuilt in place (same partIndex) when a photo inside it is
  // deleted (STALE) or when the admin forces a full rebuild. EXPIRED means the
  // row and its membership are intact but the S3 object is gone.
  status    String   @default("READY")
  // Hash of the sorted photoId list in this part. Drives client-side download
  // tracking (localStorage): it changes only when the part's photo set changes
  // (i.e. a deletion), so a pure byte-rebuild keeps the guest's "downloaded" tick.
  membershipSig String @default("")
  // Bumped on every physical (re)build; feeds the versioned S3 key so the old
  // object stays downloadable until the new one is committed.
  generation Int      @default(1)
  photoCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  job     DownloadJob                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  entries DownloadArchivePartEntry[]

  @@unique([jobId, partIndex])
  @@map("download_archive_part")
}

// Records which photos belong to which archive part (the durable membership).
// photoId intentionally has NO foreign key to Photo: deleting a photo must NOT
// cascade-remove this row, so a reconcile build can still see which sealed part
// the now-deleted photo belonged to and rebuild exactly that part.
model DownloadArchivePartEntry {
  id      String @id @default(cuid())
  partId  String
  photoId String

  part DownloadArchivePart @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([partId, photoId])
  @@index([photoId])
  @@map("download_archive_part_entry")
}
